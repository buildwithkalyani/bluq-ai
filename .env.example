# =============================================================================
# BLUQ FRONTEND — Next.js (Vercel)
# =============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...replace_with_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJ...replace_with_service_role_key
SUPABASE_DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Better Auth provider)
GOOGLE_CLIENT_ID=replace_with_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Backend API (Fastify on Railway) — both point to the same server
# Server-side only (Server Components, Server Actions) — no NEXT_PUBLIC_ needed
FASTIFY_API_URL=http://localhost:4000
# Client-side (Socket.IO browser connection) — NEXT_PUBLIC_ prefix required by Next.js
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash Redis — REST client used by frontend (flow-engine, @upstash/redis)
# Get these from Upstash dashboard → REST API section (https:// URL, not rediss://)
UPSTASH_REDIS_REST_URL=https://your-host.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token

# Resend Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# WhatsApp Business API (Meta)
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Cron job security (secret shared between Vercel cron and Next.js API routes)
CRON_SECRET=replace_with_a_random_secret
