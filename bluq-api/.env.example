# =============================================================================
# BLUQ BACKEND — Fastify (Railway)
# =============================================================================

PORT=3001

# SSL — download from Supabase Dashboard > Settings > Database > SSL Certificate
# Place in root certs/prod-ca-2021.crt (folder is gitignored)
NODE_EXTRA_CA_CERTS=../certs/prod-ca-2021.crt

# Supabase
SUPABASE_DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...replace_with_service_role_key

# Better Auth
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
BETTER_AUTH_URL=https://bluq.ai

# Admin
APP_URL=https://bluq.ai
API_URL=https://bluq-api.railway.app
ADMIN_SECRET=replace_with_a_long_random_secret

# Upstash Redis (ioredis — credentials embedded in URL)
UPSTASH_REDIS_URL=rediss://default:your_password_here@your-host.upstash.io:6379

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=BluQ <no-reply@bluq.ai>
DEMO_NOTIFY_EMAIL=demo-notify@example.com

# WhatsApp Business API (Meta)
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
